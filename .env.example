# Razorpay Configuration
# Get these keys from your Razorpay dashboard: https://dashboard.razorpay.com/app/keys
REACT_APP_RAZORPAY_KEY_ID=your_razorpay_key_id_here
REACT_APP_RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Backend API URL
REACT_APP_API_URL=http://localhost:8000/api

# Public HTTPS scheduling page shown after a Meet an Expert request.
# Do not put Calendly API keys or other secrets in this frontend variable.
REACT_APP_EXPERT_BOOKING_URL=https://calendar.app.google/your-appointment-link
